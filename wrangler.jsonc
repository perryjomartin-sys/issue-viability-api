{
  // Cloudflare Worker config. Deployed to
  // https://issue-viability-api.agentactiongateway.workers.dev.
  "name": "issue-viability-api",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // Shared rate-limit-floor coordination for the single GitHub credential.
  // SQLite-backed DO — allowed on the Workers Free plan via new_sqlite_classes.
  "durable_objects": {
    "bindings": [{ "name": "RATE_BUDGET", "class_name": "RateBudgetDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateBudgetDO"] }],

  // Fleet-wide fresh/stale production cache, replacing the isolate-local MemoryCache.
  // Entries expire after the stale-cache window. Workers KV is eventually consistent;
  // cache misses safely fall through to GitHub.
  "kv_namespaces": [
    { "binding": "VIABILITY_CACHE", "id": "c40855d65e2b4a5c84620d791da34a9e" }
  ],

  // Non-secret Base Sepolia configuration. This is the default Worker and the
  // only target used by the ordinary deployment workflow.
  "vars": {
    "X402_ENABLED": "true",
    "X402_NETWORK": "eip155:84532",
    "X402_ASSET": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
    "X402_PRICE": "$0.005",
    "X402_BAZAAR": "true"
  },

  // Separate Worker identity and state namespace for Base mainnet. This KV
  // namespace was created through the mainnet Wrangler environment; it is not
  // the Sepolia namespace above.
  "env": {
    "mainnet": {
      "name": "issue-viability-api-mainnet",
      "durable_objects": {
        "bindings": [{ "name": "RATE_BUDGET", "class_name": "RateBudgetDO" }]
      },
      // Migrations are explicit per Worker identity so the mainnet RATE_BUDGET
      // class has isolated Durable Object storage from the default (Sepolia) Worker.
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateBudgetDO"] }],
      "kv_namespaces": [
        { "binding": "VIABILITY_CACHE", "id": "38a6dfdb562544bbb09ac45d5d03a074" }
      ],
      "vars": {
        "X402_ENABLED": "true",
        "X402_NETWORK": "eip155:8453",
        "X402_ASSET": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
        "X402_FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
        "X402_RESOURCE_URL": "https://issue-viability-api-mainnet.agentactiongateway.workers.dev/v1/check",
        "X402_MAINNET_APPROVED": "true",
        "X402_PRICE": "$0.005",
        "X402_BAZAAR": "true"
      }
    }
  }

  // Secrets, set with `wrangler secret put <NAME>` (NOT done):
  //   GITHUB_TOKEN     GitHub read token
  //   X402_PAY_TO      Address that receives USDC; set separately per Worker
  //   X402_RESOURCE_URL  public URL of POST /v1/check (for discovery)
  //   X402_FACILITATOR_URL  optional Sepolia override; default x402.org testnet
  // Mainnet-only runtime secrets (never commit values):
  //   CDP_API_KEY_ID
  //   CDP_API_KEY_SECRET
}
